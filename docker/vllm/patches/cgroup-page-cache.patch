+def _read_reclaimable_page_cache(stat_path: str, file_key: str, shmem_key: str) -> int:
+    stats = {}
+    try:
+        with open(stat_path) as f:
+            for line in f:
+                name, _, value = line.partition(" ")
+                stats[name] = int(value)
+    except (OSError, ValueError):
+        return 0
+    return max(0, stats.get(file_key, 0) - stats.get(shmem_key, 0))
+
