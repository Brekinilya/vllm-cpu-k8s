{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "privacy": {
      "()": "vllm_privacy.filters.PrivacyFilter"
    }
  },
  "formatters": {
    "vllm": {
      "()": "vllm.logging_utils.NewLineFormatter",
      "format": "%(levelname)s %(asctime)s [%(name)s:%(lineno)d] %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "formatter": "vllm",
      "filters": ["privacy"],
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "vllm": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "vllm_privacy": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["stdout"],
      "level": "WARNING",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["stdout"],
    "level": "WARNING"
  }
}
